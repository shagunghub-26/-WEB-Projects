
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>CampusLink | CM25112</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
    }

    .event-card {
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .event-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.10);
    }

    .active-filter {
      background-color: #2563eb;
      color: white;
      border-color: #2563eb;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800">

  <!-- Navbar -->
  <nav class="bg-white shadow-sm sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-5 py-3 flex flex-wrap items-center justify-between gap-3">

      <!-- Logo and Project Code -->
      <div class="flex flex-col leading-none">
        <a href="#home"
           class="text-2xl md:text-3xl font-bold text-blue-600">
          CampusLink<span class="text-orange-500">.</span>
        </a>

        <span class="text-2xl md:text-3xl font-extrabold text-blue-600 mt-1">
          CM25112
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-3 md:gap-6 font-medium text-sm md:text-base">
        <a href="#home" class="hover:text-blue-600">Home</a>
        <a href="#events" class="hover:text-blue-600">Events</a>
        <a href="#about" class="hover:text-blue-600">About</a>
      </div>

      <a href="#events"
         class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
        Get Started
      </a>

    </div>
  </nav>

  <!-- Hero Section -->
  <section id="home"
           class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white">

    <div class="max-w-7xl mx-auto px-5 py-16 md:py-24 grid md:grid-cols-2 gap-10 items-center">

      <div>
        <p class="text-blue-200 font-semibold mb-4">
          YOUR CAMPUS. YOUR COMMUNITY.
        </p>

        <h1 class="text-4xl md:text-6xl font-bold leading-tight">
          Discover Events.<br>
          Connect with Students.
        </h1>

        <p class="mt-6 text-blue-100 text-lg">
          Explore college events, workshops and hackathons.
          Find opportunities to learn, participate and grow.
        </p>

        <a href="#events"
           class="inline-block mt-8 bg-white text-blue-700 font-bold px-7 py-3 rounded-xl hover:bg-blue-50">
          Explore Events →
        </a>
      </div>

      <div class="bg-white/10 border border-white/20 rounded-3xl p-6 md:p-10">

        <div class="text-6xl mb-5">🎓</div>

        <h2 class="text-3xl font-bold">
          One platform, endless opportunities.
        </h2>

        <p class="mt-4 text-blue-100">
          Discover technical, educational and cultural activities
          happening in the student community.
        </p>

        <div class="grid grid-cols-2 gap-4 mt-8">

          <div class="bg-white/10 rounded-xl p-4">
            <p id="eventCount" class="text-3xl font-bold">6</p>
            <p class="text-sm text-blue-100">Events Listed</p>
          </div>

          <div class="bg-white/10 rounded-xl p-4">
            <p id="registrationCount" class="text-3xl font-bold">0</p>
            <p class="text-sm text-blue-100">My Registrations</p>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Events Section -->
  <section id="events" class="max-w-7xl mx-auto px-5 py-16">

    <div class="text-center mb-10">
      <p class="text-blue-600 font-semibold">
        FIND YOUR NEXT OPPORTUNITY
      </p>

      <h2 class="text-3xl md:text-4xl font-bold mt-2">
        Explore Campus Events
      </h2>

      <p class="text-slate-500 mt-3">
        Search events and discover something new.
      </p>
    </div>

    <!-- Search Bar -->
    <div class="max-w-2xl mx-auto mb-6">
      <input
        type="text"
        id="searchInput"
        placeholder="Search events, workshops, hackathons..."
        aria-label="Search events"
        class="w-full border border-slate-300 rounded-xl px-5 py-4 outline-none focus:ring-2 focus:ring-blue-500">
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap justify-center gap-3 mb-10">

      <button type="button"
              class="filter-btn active-filter border rounded-full px-5 py-2"
              data-category="All">
        All Events
      </button>

      <button type="button"
              class="filter-btn border rounded-full px-5 py-2 hover:bg-blue-50"
              data-category="Technical">
        Technical
      </button>

      <button type="button"
              class="filter-btn border rounded-full px-5 py-2 hover:bg-blue-50"
              data-category="Workshop">
        Workshop
      </button>

      <button type="button"
              class="filter-btn border rounded-full px-5 py-2 hover:bg-blue-50"
              data-category="Cultural">
        Cultural
      </button>

      <button type="button"
              class="filter-btn border rounded-full px-5 py-2 hover:bg-blue-50"
              data-category="Career">
        Career
      </button>

    </div>

    <!-- Event Cards -->
    <div id="eventContainer"
         class="grid sm:grid-cols-2 lg:grid-cols-3 gap-7">
    </div>

    <p id="noResults"
       class="hidden text-center text-slate-500 py-10">
      No events found. Try another search.
    </p>

  </section>

  <!-- About Section -->
  <section id="about" class="bg-white border-t">

    <div class="max-w-5xl mx-auto px-5 py-16 text-center">

      <h2 class="text-3xl font-bold">
        About CampusLink
      </h2>

      <p class="mt-5 text-slate-600 leading-7 max-w-3xl mx-auto">
        CampusLink is a student-focused platform concept designed
        to bring college events and opportunities together in one
        place. It helps students discover activities, explore new
        interests and participate in campus life.
      </p>

      <div class="grid md:grid-cols-3 gap-6 mt-10 text-left">

        <div class="bg-blue-50 p-6 rounded-2xl">
          <div class="text-3xl">🔎</div>
          <h3 class="font-bold text-lg mt-3">Discover</h3>
          <p class="text-slate-600 mt-2">
            Find events that match your interests.
          </p>
        </div>

        <div class="bg-orange-50 p-6 rounded-2xl">
          <div class="text-3xl">🤝</div>
          <h3 class="font-bold text-lg mt-3">Connect</h3>
          <p class="text-slate-600 mt-2">
            Explore opportunities in student communities.
          </p>
        </div>

        <div class="bg-green-50 p-6 rounded-2xl">
          <div class="text-3xl">🚀</div>
          <h3 class="font-bold text-lg mt-3">Grow</h3>
          <p class="text-slate-600 mt-2">
            Learn new skills through activities and events.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-white px-5 py-8">

    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-5">

      <!-- Footer Logo and Code -->
      <div class="flex flex-col leading-none text-center md:text-left">

        <span class="text-2xl font-bold text-blue-400">
          CampusLink<span class="text-orange-400">.</span>
        </span>

        <span class="text-2xl font-extrabold text-white mt-2">
          CM25112
        </span>

      </div>

      <p class="text-slate-300 text-center">
        Connecting students with campus opportunities.
      </p>

      <p class="text-slate-400 text-sm text-center">
        © <span id="year"></span> CampusLink | Student Frontend Project
      </p>

    </div>
  </footer>

  <!-- Notification -->
  <div id="toast"
       role="status"
       aria-live="polite"
       class="hidden fixed bottom-5 right-5 left-5 sm:left-auto sm:max-w-sm bg-slate-900 text-white px-6 py-4 rounded-xl shadow-lg z-50">
  </div>

  <script>
    // Sample event data
    const events = [
      {
        id: 1,
        title: "National Hackathon",
        category: "Technical",
        icon: "💻",
        date: "15 November 2026",
        venue: "Innovation Centre",
        description: "Build creative solutions to real-world problems.",
        color: "bg-blue-100"
      },
      {
        id: 2,
        title: "Web Development Workshop",
        category: "Workshop",
        icon: "🌐",
        date: "20 November 2026",
        venue: "Computer Lab",
        description: "Learn the basics of modern frontend development.",
        color: "bg-purple-100"
      },
      {
        id: 3,
        title: "Annual Cultural Fest",
        category: "Cultural",
        icon: "🎭",
        date: "25 November 2026",
        venue: "College Auditorium",
        description: "Celebrate creativity, music, dance and culture.",
        color: "bg-orange-100"
      },
      {
        id: 4,
        title: "AI and Machine Learning",
        category: "Technical",
        icon: "🤖",
        date: "28 November 2026",
        venue: "Seminar Hall",
        description: "Explore AI applications and emerging technologies.",
        color: "bg-green-100"
      },
      {
        id: 5,
        title: "Resume Building Session",
        category: "Career",
        icon: "📄",
        date: "2 December 2026",
        venue: "Placement Cell",
        description: "Learn how to prepare a professional resume.",
        color: "bg-yellow-100"
      },
      {
        id: 6,
        title: "Git and GitHub Workshop",
        category: "Workshop",
        icon: "⚙️",
        date: "5 December 2026",
        venue: "Computer Lab",
        description: "Understand version control and team collaboration.",
        color: "bg-pink-100"
      }
    ];

    // Track registrations during this page session
    const registeredEvents = new Set();

    const eventContainer =
      document.getElementById("eventContainer");

    const searchInput =
      document.getElementById("searchInput");

    const noResults =
      document.getElementById("noResults");

    const filterButtons =
      document.querySelectorAll(".filter-btn");

    let selectedCategory = "All";
    let toastTimer;

    // Display events
    function displayEvents() {
      const searchText =
        searchInput.value.toLowerCase().trim();

      const filteredEvents = events.filter(event => {
        const matchesCategory =
          selectedCategory === "All" ||
          event.category === selectedCategory;

        const searchableText =
          `${event.title} ${event.category} ${event.description} ${event.venue}`
          .toLowerCase();

        const matchesSearch =
          searchableText.includes(searchText);

        return matchesCategory && matchesSearch;
      });

      eventContainer.innerHTML = filteredEvents.map(event => {
        const isRegistered =
          registeredEvents.has(event.id);

        return `
          <article class="event-card bg-white border border-slate-200 rounded-2xl overflow-hidden">

            <div class="${event.color} p-7">
              <div class="flex justify-between items-center">

                <span class="bg-white px-3 py-1 rounded-full text-sm font-medium">
                  ${event.category}
                </span>

                <span class="text-5xl" aria-hidden="true">
                  ${event.icon}
                </span>

              </div>
            </div>

            <div class="p-6">

              <h3 class="text-xl font-bold">
                ${event.title}
              </h3>

              <p class="text-slate-500 text-sm mt-3">
                📅 ${event.date}
              </p>

              <p class="text-slate-500 text-sm mt-2">
                📍 ${event.venue}
              </p>

              <p class="text-slate-600 mt-4 leading-6">
                ${event.description}
              </p>

              <button
                type="button"
                data-event-id="${event.id}"
                ${isRegistered ? "disabled" : ""}
                class="register-btn w-full mt-6 py-3 rounded-xl font-semibold
                ${
                  isRegistered
                    ? "bg-green-100 text-green-700 cursor-default"
                    : "bg-blue-600 text-white hover:bg-blue-700"
                }">

                ${isRegistered ? "✓ Registered" : "Register Interest"}

              </button>

            </div>
          </article>
        `;
      }).join("");

      noResults.classList.toggle(
        "hidden",
        filteredEvents.length !== 0
      );

      document.getElementById("eventCount").textContent =
        events.length;

      document.getElementById("registrationCount").textContent =
        registeredEvents.size;
    }

    // Search events
    searchInput.addEventListener("input", displayEvents);

    // Filter by category
    filterButtons.forEach(button => {
      button.addEventListener("click", () => {
        selectedCategory = button.dataset.category;

        filterButtons.forEach(btn => {
          btn.classList.remove("active-filter");
        });

        button.classList.add("active-filter");

        displayEvents();
      });
    });

    // Register interest
    eventContainer.addEventListener("click", event => {
      const button = event.target.closest(".register-btn");

      if (!button || button.disabled) {
        return;
      }

      const eventId = Number(button.dataset.eventId);

      const selectedEvent = events.find(
        item => item.id === eventId
      );

      if (!selectedEvent) {
        return;
      }

      registeredEvents.add(eventId);

      displayEvents();

      showToast(
        `You registered your interest in ${selectedEvent.title}!`
      );
    });

    // Notification message
    function showToast(message) {
      const toast = document.getElementById("toast");

      clearTimeout(toastTimer);

      toast.textContent = message;
      toast.classList.remove("hidden");

      toastTimer = setTimeout(() => {
        toast.classList.add("hidden");
      }, 3000);
    }

    // Current year
    document.getElementById("year").textContent =
      new Date().getFullYear();

    // Initial display
    displayEvents();
  </script>

</body>
</html>
