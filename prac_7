<!DOCTYPE html>
<html>
<head>
    <title>Interactive FAQ</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-r from-yellow-200 via-orange-300 to-red-400 flex items-center justify-center">

    <div class="bg-gray-100 p-6 rounded-xl shadow-lg w-80 max-w-8xl mx-auto">

        <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">
            College Facilities Portal
        </h2>

        <p class="text-center mb-5 text-gray-900">
            Frequently Asked Questions
        </p>

        <!-- FAQ 1 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-yellow-300 to-red-400 text-black rounded">
                What are the library timings?
            </button>

            <p class="answer hidden p-3 bg-yellow-100">
                The library is open from 8:00 AM to 5:00 PM.
            </p>
        </div>

        <!-- FAQ 2 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-yellow-300 to-red-400 text-black rounded">
                How can I issue a library book?
            </button>

            <p class="answer hidden p-3 bg-yellow-100">
                You can issue a library book by visiting the library counter with your student ID. You can also reserve books online through the library portal.
        </div>

        <!-- FAQ 3 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-yellow-300 to-red-400 text-black rounded">
                Is Wi-Fi available on campus?
            </button>

            <p class="answer hidden p-3 bg-yellow-100">
                Yes, Wi-Fi is available in all academic buildings and common areas. Use your college credentials to log in.
                </p>
        </div>

        <!-- FAQ 4 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-yellow-300 to-red-400 text-black rounded">
                Where can I find the computer lab?
            </button>

            <p class="answer hidden p-3 bg-yellow-100">
                The computer lab is located in the main building, on the second floor. It is open from 8:00 AM to 5:00 PM.
            </p>
        </div>

        <!-- FAQ 5 -->
        <div class="mb-3">
            <button class="question w-full text-left p-3 bg-gradient-to-r from-yellow-300 to-red-400 text-black rounded">
                How can I report a problem with college facilities?
            </button>

            <p class="answer hidden p-3 bg-yellow-100">
                Contact the college office or concerned faculty member.
            </p>
        </div>

    </div>


    <script>

        // Get all questions
        let questions = document.querySelectorAll(".question");

        // Add click event to each question
        questions.forEach(function(question) {

            question.addEventListener("click", function() {

                // Get the answer
                let answer = question.nextElementSibling;

                // Show / Hide answer
                answer.classList.toggle("hidden");

            });

        });

    </script>

</body>
</html>
